# 로컬 값은 `npx supabase status`에서 복사해 .env.local에 넣는다.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용. NEXT_PUBLIC_을 붙이면 브라우저 코드에 포함되므로 절대 붙이지 않는다.
SUPABASE_SECRET_KEY=

# 가짜 발송기 웹훅 서명 키. 앱과 워커(FAKE_WEBHOOK_SECRET)가 같은 값이어야 하며, 없으면 웹훅 경로가 404다.
FAKE_WEBHOOK_SECRET=

# 발송 워커(Edge Function)용. 로컬은 supabase/functions/.env에, 운영은 npx supabase secrets set으로 넣는다.
# WORKER_SECRET=          pg_cron이 워커를 깨울 때 쓰는 값. Vault의 send_worker_secret과 같아야 한다.
# FAKE_WEBHOOK_SECRET=    가짜 발송기 웹훅 서명 키
# APP_URL=                웹훅을 받을 앱 주소
# SEND_BATCH_SIZE=100     한 번에 집는 건수

# 실제 발송(솔라피). 키는 서버에만 둔다. 없으면 모든 계정이 가짜 발송기다. 체험 계정은 설정과 무관하게 가짜 발송기다.
# Next.js(Vercel): SOLAPI_WEBHOOK_SECRET=  솔라피 웹훅 등록 때 정한 secret. 없으면 웹훅 경로가 404다.
# Edge Function:
#   SMS_PROVIDER=solapi
#   SOLAPI_API_KEY=
#   SOLAPI_API_SECRET=
#   SOLAPI_WEBHOOK_SECRET=
#   SOLAPI_ALLOWED_RECIPIENTS=   쉼표로 구분한 내 번호. 비면 아무에게도 보내지 않는다.
#   SOLAPI_DAILY_LIMIT=10
